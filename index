<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Redirigiendo...</title>
</head>
<body>
<script>
  // If there's an access_token in the hash, redirect to inquilinos
  if (window.location.hash && window.location.hash.includes('access_token')) {
    window.location.replace('https://megaconsultora.github.io/inquilinos/' + window.location.hash);
  } else {
    window.location.replace('https://megaconsultora.github.io/locaciones/');
  }
</script>
</body>
</html>

